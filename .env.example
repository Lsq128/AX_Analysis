# AX_Analysis 环境变量
# 复制为 .env 后填写。引擎在 import 时会 load_dotenv(CWD) — Worker 启动前应 cd 到本目录或显式 load 此文件。
#
# 完整说明见 docs/completeness-audit.md §3

# =============================================================================
# LLM（v1 国内 · Worker/ai_server 专用，禁止暴露给浏览器）
# =============================================================================
DEEPSEEK_API_KEY=
DASHSCOPE_CN_API_KEY=
MOONSHOT_API_KEY=

# 国际通义（若不用 qwen-cn 可留空）
#DASHSCOPE_API_KEY=

# Phase 2+ 海外模型（v1 可不填）
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=

# =============================================================================
# 数据 API（引擎 dataflows 会读取）
# =============================================================================

# 宏观：News Analyst · get_macro_indicators（default macro_data=fred）
# 免费：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 可选：yfinance 失败时的 fallback（core_stock / news / fundamentals）
#ALPHA_VANTAGE_API_KEY=

# =============================================================================
# 引擎行为 TRADINGAGENTS_*（与根目录 TradingAgents .env 语义相同）
# =============================================================================
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# 429 限流时提高重试（建议 6）
TRADINGAGENTS_LLM_MAX_RETRIES=6

# 断点续跑（SaaS 多用户须在 Worker 设 per-user TRADINGAGENTS_CACHE_DIR）
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# 采样温度（可选）
#TRADINGAGENTS_TEMPERATURE=

# =============================================================================
# SaaS 路径（生产必须 per-user，勿用默认 ~/.tradingagents）
# Worker 按 job 注入，示例：
# TRADINGAGENTS_RESULTS_DIR=/data/users/{user_id}/logs
# TRADINGAGENTS_CACHE_DIR=/data/users/{user_id}/cache
# TRADINGAGENTS_MEMORY_LOG_PATH=/data/users/{user_id}/memory/trading_memory.md
# =============================================================================

# =============================================================================
# AX 基础设施（Phase 1+）
# =============================================================================
# Job 队列（生产推荐 Redis；本地无 Redis 时可 AX_JOB_STORE=memory）
REDIS_URL=redis://localhost:6379/0
#AX_JOB_STORE=memory

# PostgreSQL（启用后任务持久化 + 配额；需同时配置 REDIS_URL）
DATABASE_URL=postgresql://ax:ax@localhost:5432/ax_analysis

# API 默认端口 8000（uvicorn）
#AX_API_HOST=0.0.0.0
#AX_API_PORT=8000

# 按 IP 滑动窗口限流（每分钟请求数；创建分析任务更严格）
#AX_API_RATE_LIMIT_RPM=120

#DATABASE_URL=postgresql://...

# =============================================================================
# 鉴权（JWT）
# =============================================================================
# 生产务必更换 JWT_SECRET；关闭 dev header 回退：AX_AUTH_ALLOW_HEADER=false
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168
AX_AUTH_ALLOW_HEADER=true
AX_AUTH_DEV_MODE=true
AX_AUTH_DEV_LOGIN=true

# 生产 Auth（PR6）
# AX_AUTH_DEV_MODE=false
# AX_AUTH_ALLOW_HEADER=false
# AX_AUTH_DEV_LOGIN=false
# AX_WEB_URL=https://app.example.com
# AX_OAUTH_PROVIDERS=github,oidc
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# AX_OAUTH_REDIRECT_URI=https://app.example.com/api/v1/auth/oauth/github/callback
# OAUTH_OIDC_CLIENT_ID=
# OAUTH_OIDC_CLIENT_SECRET=
# OAUTH_OIDC_AUTHORIZE_URL=
# OAUTH_OIDC_TOKEN_URL=
# OAUTH_OIDC_USERINFO_URL=
# OAUTH_OIDC_SCOPE=openid profile email

# Web 端（与 API 一致关闭 header 回退）
# NEXT_PUBLIC_AUTH_ALLOW_HEADER=false

# =============================================================================
# 套餐计费 + Admin（PR7 · 默认关闭，个人自用）
# =============================================================================
# 设为 true 时恢复套餐门控与点数扣减；false/未设置 = 个人模式不计费
AX_BILLING_ENABLED=false

# 新用户默认套餐：free | standard | pro（仅 AX_BILLING_ENABLED=true 时有意义）
#AX_DEFAULT_PLAN_ID=standard

# 管理员 external_id（逗号分隔，与 JWT sub / X-User-Id 一致）
#AX_ADMIN_USER_IDS=admin-user-id

# 可选：服务端 Admin API Key（请求头 X-Admin-Key）
#AX_ADMIN_API_KEY=

# A 股数据：pip install -e ".[cn]"  （AKShare；未装则 A 股回退 yfinance）

# =============================================================================
# 报告存储（PR3 · OSS / S3 兼容）
# =============================================================================
# local（默认）：Worker 写本地磁盘，API 直接读 report_path
# s3：Worker 上传后 DB 存 storage key（reports/{user_id}/{job_id}）
#AX_REPORT_STORAGE=local
#AX_REPORT_LOCAL_ROOT=./data/report_storage

# S3 兼容（AWS / 阿里云 OSS / MinIO）
#AX_REPORT_STORAGE=s3
#AX_S3_BUCKET=ax-reports
#AX_S3_REGION=cn-hangzhou
#AX_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#AX_S3_ACCESS_KEY=
#AX_S3_SECRET_KEY=
#AX_REPORT_SIGNED_URL_TTL=3600
#AX_REPORT_DELETE_LOCAL_AFTER_UPLOAD=true
